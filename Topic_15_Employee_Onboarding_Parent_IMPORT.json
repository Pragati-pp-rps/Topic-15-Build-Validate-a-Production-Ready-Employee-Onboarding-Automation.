      "name": "Create Pending Employee",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        270,
        -260
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.onboarding_employees (employee_name,email,manager_email,department,start_date,status,manager_token,hr_token) VALUES ($1,$2,$3,$4,$5::date,'PENDING_MANAGER',md5(random()::text||clock_timestamp()::text),md5(random()::text||clock_timestamp()::text)) RETURNING id,employee_name,email,manager_email,department,start_date,status,manager_token,hr_token;",
        "options": {
          "queryReplacement": "={{ [$('Validate Employee Request').first().json.employee_name,$('Validate Employee Request').first().json.email,$('Validate Employee Request').first().json.manager_email,$('Validate Employee Request').first().json.department,$('Validate Employee Request').first().json.start_date] }}"
        }
      }
    },
    {
      "id": "a792999c-25ac-4c1a-a5b8-925e247c2b59",
      "name": "Prepare Manager Approval Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
