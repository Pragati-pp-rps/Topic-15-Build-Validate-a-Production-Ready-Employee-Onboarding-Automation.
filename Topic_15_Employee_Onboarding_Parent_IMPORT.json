      "parameters": {
        "jsCode": "const e=$input.first().json;const base='REPLACE_WITH_YOUR_N8N_PUBLIC_BASE_URL';const u=base+'/webhook/topic15/approval';return [{json:{...e,slack_text:`New employee onboarding: ${e.employee_name} (${e.email})\\nDepartment: ${e.department}\\nManager: ${e.manager_email}\\nApprove: ${u}?token=${e.manager_token}&decision=approve&stage=manager\\nReject: ${u}?token=${e.manager_token}&decision=reject&stage=manager`}}];"
      }
    },
    {
      "id": "513efd44-98ab-4f00-b6f0-894806401887",
      "name": "Slack - Manager Approval Alert",
      "type": "n8n-nodes-base.httpRequest",
