          },
          "conditions": [
            {
              "id": "a6afc449-9dce-4e97-9418-b308be048790",
              "leftValue": "={{ $json.duplicate }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
