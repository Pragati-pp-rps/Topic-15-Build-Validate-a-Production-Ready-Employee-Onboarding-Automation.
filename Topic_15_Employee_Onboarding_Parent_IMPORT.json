    {
      "id": "aea7aa1b-d9fd-4fa6-8078-f73c9007d8d5",
      "name": "Validate Employee Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -860,
        0
      ],
      "parameters": {
        "jsCode": "const raw=$input.first().json;const p=raw.body||raw;const email=String(p.email||'').trim().toLowerCase();const manager=String(p.manager_email||'').trim().toLowerCase();const name=String(p.employee_name||'').trim();const department=String(p.department||'').trim();const start=String(p.start_date||'').trim();const valid=/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)&&/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(manager)&&!!name&&!!department&&/^\\d{4}-\\d{2}-\\d{2}$/.test(start);return [{json:{employee_name:name,email,manager_email:manager,department,start_date:start,valid,error:valid?'':'Provide employee_name, valid email, manager_email, department and start_date (YYYY-MM-DD)',request_id:$execution.id}}];"
      }
    },
    {
      "id": "5e22ce49-2d31-41b6-ab7a-80b2f7a5851e",
      "name": "Valid Request?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -630,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "96937d8b-e251-4d95-aae3-be74e006e4dc",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "352f3aa5-7e57-4190-a77b-34094c42f5a6",
      "name": "Check Existing Employee",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -390,
        -140
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, status FROM public.onboarding_employees WHERE email=$1 LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [$('Validate Employee Request').first().json.email] }}"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "c0017766-13e2-47c4-91e9-e2ed366e0f0a",
      "name": "Check Duplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -170,
        -140
      ],
      "parameters": {
        "jsCode": "const r=$input.all();return [{json:{duplicate:r.length>0&&!!r[0].json.id,existing:r[0]?.json||{}}}];"
      }
    },
    {
